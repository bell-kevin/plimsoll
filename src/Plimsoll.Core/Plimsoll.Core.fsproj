<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Plimsoll.Core</RootNamespace>
    <AssemblyName>Plimsoll.Core</AssemblyName>
    <!-- The engine has no package dependencies at all: the whole solver is in
         this repository, which keeps the licence story simple and the build
         reproducible offline. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <OtherFlags>$(OtherFlags) --nowarn:3370</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Rational.fs" />
    <Compile Include="Dimension.fs" />
    <Compile Include="Interval.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Units.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Dimensional.fs" />
    <Compile Include="Contractor.fs" />
    <Compile Include="Solver.fs" />
    <Compile Include="Model.fs" />
  </ItemGroup>

</Project>
